
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Dashboard</title>
    <link rel="stylesheet" href="/doctorDashboard.css">
    <script>
        document.addEventListener("DOMContentLoaded", function () {
    fetch('/patients')
        .then(response => response.json())
        .then(data => {
            const patientsTable = document.getElementById('patientsTableBody');

            if (data.patients.length > 0) {
                data.patients.forEach(patient => {
                    patientId = patient.id
                    // Add patient data to the table dynamically
                    const row = `
                        <tr>
                            <td>${patient.first_name} ${patient.last_name}</td>
                            <td>${patient.gender}</td>
                            <td>${patient.age}</td>
                            <td>${patient.phone}</td>
                            <td>${patient.address}</td>
                            <td>
                                <input type="number" class="num-in" id="content-${patient.id}" placeholder="Num" maxlength="5" required>
                                <button type="button" class="num-btn" onclick="sendPatientData(${patient.id})">Send</button>
                            </td>
                            <td>${new Date(patient.created_at).toLocaleDateString()}</td>
                        </tr>`;
                    patientsTable.innerHTML += row;
                });
            } else {
                patientsTable.innerHTML = '<tr><td colspan="7">No patients found.</td></tr>';
            }
        })
        .catch(err => {
            console.error('Error fetching patients:', err);
        });
});

// Function to handle "Send" button click
function sendPatientData(patientId) {
    // Find the input field and its value
    const inputField = document.getElementById(`content-${patientId}`);
    const additionalNumber = inputField.value;

    if (!additionalNumber) {
        alert('Please enter a number before sending.');
        return;
    }

    // Locate the corresponding table row
    const row = inputField.closest('tr');

    // Gather patient data from the row
    const patientData = {
        id: patientId,
        name: row.children[0].textContent.trim(),
        gender: row.children[1].textContent.trim(),
        age: row.children[2].textContent.trim(),
        phone: row.children[3].textContent.trim(),
        address: row.children[4].textContent.trim(),
        additionalNumber: additionalNumber,
        addedOn: row.children[6].textContent.trim(),
    };

    // Send data to the backend
    fetch('/sendPatientData', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(patientData),
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(`Data for ${patientData.name} sent successfully!`);
            } else {
                alert('Failed to send data. Please try again.');
            }
        })
        .catch(error => {
            console.error('Error sending data:', error);
            alert('An error occurred while sending the data.');
        });
}

    </script>
    
</head>
<body>
