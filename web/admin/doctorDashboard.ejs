        <button id="toggleButton"><<</button>

    <div>
        <h1><%= doctor.name %></h1></br>
        <h2><%= doctor.skills %></h2>
        
    </div>

        <div class="numbers">
            <p>Current Number: <span id="current-number">0</span></p>
            <button id="reset-btn" onclick="updateNumber('reset', <%= doctor.id %>)">Reset</button>
            <button id="decrement-btn" onclick="updateNumber('decrement', <%= doctor.id %>)">Prev</button>
            <button id="increment-btn" onclick="updateNumber('increment', <%= doctor.id %>)">Next</button>
        </div>

    </div>

        <h1 id="doctorWelcome"></h1>
        <h2 class="main-pat">Your Patients</h2>        
    <table border="1">
        <thead>
            <tr>
                <th>Name</th>
                <th>Gender</th>
                <th>Age</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Number</th>
                <th>Added On</th>
            </tr>
        </thead>
        <tbody id="patientsTableBody">
        </tbody>
    </table>

        </div>
      </div>


    <script>
    const toggleButton = document.getElementById('toggleButton');
        const sidebar = document.getElementById('sidebar');
        const main = document.getElementById('main');
        const bar = document.getElementById('bar');
        const container = document.getElementById('container');
        
        toggleButton.addEventListener('click', () => {
          sidebar.classList.toggle('hidden');
          main.classList.toggle('hidden');
          bar.classList.toggle('hidden');
          container.classList.toggle('sidebar-hidden');
        
          if (sidebar.classList.contains('hidden')) {
            toggleButton.textContent = '>>';
          } else {
            toggleButton.textContent = '<<';
          }
        });
        </script>
        <script>
            let currentNumber = 0;

function updateNumber(action, button) {
    if (action === 'reset') {
        currentNumber = 0;
    } else if (action === 'increment') {
        currentNumber++;
    } else if (action === 'decrement' && currentNumber > 0) {
        currentNumber--;
    }

    document.getElementById('current-number').textContent = currentNumber;

    document.getElementById('reset-btn').disabled = currentNumber <= 0;
    document.getElementById('decrement-btn').disabled = currentNumber <= 0;

    if (button) {
        button.classList.add('clicked');
        setTimeout(() => button.classList.remove('clicked'), 200);
    }
}

document.addEventListener('keydown', function (event) {
    let action = null;
    let button = null;

    if (event.key === 'r' || event.key === 'R') {
        action = 'reset';
        button = document.getElementById('reset-btn');
    } else if (event.key === 'ArrowUp' || event.key === 'ArrowRight' || event.key === ' ') {
        action = 'increment';
        button = document.getElementById('increment-btn');
    } else if (event.key === 'ArrowDown' || event.key === 'ArrowLeft') {
        if (currentNumber <= 0) {
            event.preventDefault();
            return;
        }
        action = 'decrement';
        button = document.getElementById('decrement-btn');
    }

    if (action) {
        event.preventDefault();
        updateNumber(action, button);
    }
});

document.getElementById('reset-btn').disabled = true;
document.getElementById('decrement-btn').disabled = true;

