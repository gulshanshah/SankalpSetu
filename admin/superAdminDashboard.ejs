<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Admin Dashboard</title>
    <link rel="stylesheet" href="/superAdminDashboard.css">
</head>
<body>
    <h1>Welcome! <a href="/superAdminDashboard">Status</a></h1>
    <button id="addHospitalButton">Add a Hospital</button>
    <button id="addDoctorButton">Add a Doctor</button>

    <div id="addHospital" class="addHospital">
        <div class="addHospitalContent">
            <span id="closeAddHospital" class="closeAddHospital">&times;</span>
            <form class="add-hospital-form" id="hospitalForm" action="/addHospital" method="POST" enctype="multipart/form-data">
                <h2 class="add-hospital-heading">Add a <span>Hospital</span></h2>
        
                <div class="photo-upload-container">
                    <label for="hospitalPhotoInput" class="upload-label">
                        <i class="fas fa-camera icon"></i>
                        <span>Add a Photo</span>
                        <input type="file" id="hospitalPhotoInput" name="hospitalPhoto" accept="image/*" onchange="previewHospitalImage(event)" required>
                    </label>
                    <div id="hospitalPhotoPreview" class="photo-preview">
                        <img id="hospitalPreviewImage" src="#" alt="Photo Preview" style="display: none;">
                    </div>
                </div>
        
                <div class="add-hospital-input">
                    <input type="text" name="hospitalName" placeholder="Hospital name..." id="hospitalNameInput" required>
                </div>
                <div class="add-hospital-input">
                    <input type="text" name="hospitalAddress" placeholder="Address..." id="hospitalAddressInput" required>
                </div>
                <div class="add-hospital-input">
                    <i class="fas fa-user icon"></i>
                    <input type="text" name="hospitalUsername" placeholder="Username" id="hospitalUserInput" required>
                </div>
                <div class="add-hospital-input">
                    <i class="fas fa-lock icon"></i>
                    <input type="password" name="hospitalPassword" placeholder="Password" id="hospitalPasswordInput" required>
                </div>
                <div class="add-hospital-input">
                    <textarea name="hospitalSearchDetails" placeholder="Search details..." id="hospitalSearchDetailsInput" required></textarea>
                </div>
                <div>
                    <button type="submit" class="add-hospital-btn">+Add Hospital</button>
                </div>
            </form>       
        </div>
    </div>

    <div id="addDoctor" class="addDoctor">
        <div class="addDoctorContent">
            <span id="closeAddDoctor" class="closeAddDoctor">&times;</span>
    <form class="add-doctor-form" id="doctorForm" action="/addDoctor" method="POST" enctype="multipart/form-data">
        <h2 class="add-doctor-heading">Add a <span>Doctor</span></h2>

        <div class="photo-upload-container">
            <label for="doctorPhotoInput" class="upload-label">
                <i class="fas fa-camera icon"></i>
                <span>Add a Photo</span>
                <input type="file" id="doctorPhotoInput" name="doctorPhoto" accept="image/*" onchange="previewDoctorImage(event)" required>
            </label>
            <div id="doctorPhotoPreview" class="photo-preview">
                <img id="doctorPreviewImage" src="#" alt="Photo Preview" style="display: none;">
            </div>
        </div>

        <div class="add-doctor-input">
            <input type="text" name="doctorName" placeholder="Doctor name..." id="doctorNameInput" required>
        </div>
        <div class="add-doctor-input">
            <input type="number" name="hospitalId" placeholder="Hospital ID" id="hospitalIdInput" required>
        </div>
        <div class="add-doctor-input">
            <input type="text" name="doctorSkills" placeholder="Skills..." id="doctorSkillsInput" required>
        </div>
        <div class="add-doctor-input">
            <i class="fas fa-user icon"></i>
            <input type="text" name="doctorUsername" placeholder="Username" id="doctorUserInput" required>
        </div>
        <div class="add-doctor-input">
            <i class="fas fa-lock icon"></i>
            <input type="password" name="doctorPassword" placeholder="Password" id="doctorPasswordInput" required>
        </div>
        <div>
            <button type="submit" class="add-doctor-btn">+Add Doctor</button>
        </div>
    </form>
    </div>
    </div>
    <script src="/superAdminDashboard.js"></script>
</body>
</html>